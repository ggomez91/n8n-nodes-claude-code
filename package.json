{
  "name": "@ggomez91/n8n-nodes-claude-code",
  "version": "0.7.1",
  "description": "Use Claude Code in n8n with your existing Claude Pro/Max subscription. Invokes the local Claude Code CLI as a subprocess and returns structured JSON. No API key, no per-token billing.",
  "license": "MIT",
  "homepage": "https://github.com/ggomez91/n8n-nodes-claude-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggomez91/n8n-nodes-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/ggomez91/n8n-nodes-claude-code/issues"
  },
  "author": {
    "name": "Gustavo Gómez",
    "url": "https://github.com/ggomez91"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "dist/nodes/Claude/Claude.node.js",
  "files": [
    "dist",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && gulp build:icons",
    "lint": "eslint nodes test --ext .ts",
    "format": "prettier --write \"nodes/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "n8n-community-node-package",
    "claude",
    "claude-code",
    "claude-pro",
    "claude-max",
    "anthropic",
    "ai",
    "llm",
    "no-api-key",
    "subscription-based",
    "cli-wrapper"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/Claude/Claude.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.71.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.0"
  }
}
